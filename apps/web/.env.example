# Copy to .env.local — never commit secrets
VITE_PRISM_API_KEY=your-gateway-bearer-key
# Dev proxy target (optional; default https://api.prism.ailib.info)
VITE_PRISM_PROXY_TARGET=https://api.prism.ailib.info
# Browser direct calls in production build (empty = use relative /v1 via same-origin proxy)
VITE_PRISM_BASE_URL=
# Optional: admin token for /admin/health latency metrics in provider nav (dev only)
VITE_PRISM_ADMIN_TOKEN=
# E2E cloud sync (EOS-P2-003 compatible /api/sync) — bearer session from Eos login
VITE_SYNC_PROXY_TARGET=https://eos.ailib.info
VITE_SYNC_BASE_URL=
VITE_SYNC_AUTH_TOKEN=
